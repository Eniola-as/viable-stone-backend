# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Core ---------------------------------------------------------------- #
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=false

# --- Database ---------------------------------------------------------- #
DATABASE_URL=postgresql://database-user:database-password@127.0.0.1:5432/database-name
# Optional: name for the test database (defaults to test_<db name>)
# TEST_DB_NAME=test_viable_stone

# --- Cache / Redis --------------------------------------------------------- #
# `docker compose up -d` brings real Redis on 127.0.0.1:6379. Production
# REQUIRES REDIS_URL and never falls back to process memory.
REDIS_URL=redis://127.0.0.1:6379/0
# "locmem" (default, no server needed) or "redis"
CACHE_BACKEND=locmem
# When true, the readiness probe pings Redis and 503s if it is unreachable.
REDIS_HEALTHCHECK=false
# Separate Redis DB for the real-Redis integration test suite.
TEST_REDIS_URL=redis://127.0.0.1:6379/15

# --- Hosts / CORS / CSRF ------------------------------------------------- #
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Auth / lockout ---------------------------------------------------- #
AXES_ENABLED=true
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=0.25

# --- Throttle rates (DRF ScopedRateThrottle) --------------------------- #
THROTTLE_AUTH_LOGIN=10/min
THROTTLE_AUTH_MFA=10/min
THROTTLE_AUTH_RECOVERY=5/min
THROTTLE_SALES_WRITE=120/min
THROTTLE_OFFLINE_SYNC=60/min
THROTTLE_NOTIFICATIONS_WRITE=60/min

# --- Web Push (VAPID) ------------------------------------------------- #
# Browser push is best-effort only; the durable in-app notification is always
# the record of truth. Generate a key pair once (e.g. `vapid --gen`). Push is
# only attempted when all three are set. The PRIVATE key is a SECRET: keep it
# only here, never in an API response, a log line or openapi.yml. Only the
# PUBLIC key is served to the browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=
# Seconds a push service should retain an undelivered message.
PUSH_DEFAULT_TTL=600

# --- Offline fixed-price checkout ----------------------------------- #
# Server-side secret used to sign the offline catalogue authorization
# package. A SECRET: keep it only here / in the deployment environment, never
# in an API response, a log line or openapi.yml. Leave blank to fall back to
# SECRET_KEY; set a distinct value to rotate offline authorizations
# independently of sessions.
OFFLINE_SIGNING_KEY=
# Maximum offline sales accepted in one synchronisation batch.
OFFLINE_SYNC_MAX_BATCH=200

# --- Uploads ---------------------------------------------------------- #
MAX_UPLOAD_SIZE=5242880
# PRIVATE_MEDIA_ROOT=/var/lib/viable-stone/private-media

# --- Business identity (printed on receipts) ------------------------- #
# Every field below feeds settings.BUSINESS_IDENTITY and appears on the PDF/JSON
# receipt. These are the shop's own public contact details (not secrets), but
# the real values belong only in .env / the deployment environment — the
# placeholders below are illustrative. Leave a line blank to omit it.
BUSINESS_NAME=Viable Stone Paints & Coatings Enterprise
BUSINESS_PHONE=+234-800-000-0000
BUSINESS_EMAIL=receipts@your-business.example
BUSINESS_ADDRESS=123 Example Street, City, State
# Absolute path (or relative to the project root) to a PNG/JPG logo; blank = none.
BUSINESS_LOGO_PATH=
# Shown before amounts, e.g. "NGN 3,000.00". The built-in PDF fonts have no
# Naira glyph, so a non-Latin-1 symbol (e.g. the Naira sign) is shown as "NGN".
BUSINESS_CURRENCY_SYMBOL=NGN

# --- Logging / API docs -------------------------------------------- #
# "console" (human-readable, dev) or "json" (one object per line, prod/Railway).
LOG_FORMAT=console
# API schema + Swagger/ReDoc: true in dev; production forces owner/tech-admin
# only, or fully off when this is false.
API_DOCS_ENABLED=true

# --- Monitoring (production; inert without SENTRY_DSN) ------------- #
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Production transport security -------------------------------- #
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Keep this false until a real, stable apex domain is confirmed.
SECURE_HSTS_PRELOAD=false

# --- Private file storage (production) --------------------------- #
# "local" = private media on disk (fine for a first build, NOT durable in a
# container). "s3" = a generic private S3-compatible bucket; requires
# `pip install "django-storages[s3]"` and the AWS_S3_* values below.
DJANGO_STORAGE_BACKEND=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
# Seconds a signed download URL stays valid.
AWS_QUERYSTRING_EXPIRE=300

# --- Gunicorn (production image) -------------------------------- #
WEB_CONCURRENCY=3
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=30
GUNICORN_GRACEFUL_TIMEOUT=30

# --- Demo data (development only) ------------------------------ #
# Consumed by `manage.py seed_demo`. Never commit real values; .env is ignored.
DEMO_OWNER_PASSWORD=
DEMO_EMPLOYEE_PASSWORD=
